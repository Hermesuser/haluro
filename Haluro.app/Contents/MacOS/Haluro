#!/bin/bash
# Executable launcher for Haluro — Laboratorio Analógico Digital (macOS Native App)

BUNDLE_PARENT="$(cd "$(dirname "$0")/../../.." && pwd)"
if [ -f "$BUNDLE_PARENT/native_app.py" ]; then
    APP_DIR="$BUNDLE_PARENT"
else
    APP_DIR="/Users/cefernan/Documents/Antigravity/mfilm-darkrooms"
fi

export PATH="/opt/anaconda3/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

if command -v /opt/anaconda3/bin/python3 >/dev/null 2>&1; then
    PYTHON_EXEC="/opt/anaconda3/bin/python3"
else
    PYTHON_EXEC="$(command -v python3)"
fi

cd "$APP_DIR" || exit 1
exec "$PYTHON_EXEC" "$APP_DIR/native_app.py" "$@"
