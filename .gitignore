# Python bytecode & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/

# Build & installer outputs
build/
dist/
Haluro.app/
AppIcon.icns
.pkgmeta/
*.egg-info/

# Generated packaging metadata (rendered from *.in templates at build time)
packaging/windows/version_info.txt
packaging/windows/haluro_installer.iss

# Runtime user state (non-destructive workspace buffers & logs)
uploads/*
!uploads/.gitkeep
developed/*
!developed/.gitkeep
logs/

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Design-audit evidence (local only)
.taste-skill/
